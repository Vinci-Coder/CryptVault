# Database
DATABASE_URL=postgresql+asyncpg://cryptvault:password@localhost:5432/cryptvault_db
DATABASE_TEST_URL=postgresql+asyncpg://cryptvault:password@localhost:5432/cryptvault_test_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# MS-AuthManager Integration
AUTH_MANAGER_URL=http://localhost:8001
AUTH_MANAGER_API_KEY=your-auth-manager-api-key

# Crypto Service (GO Microservice)
CRYPTO_SERVICE_URL=http://localhost:8002
CRYPTO_SERVICE_API_KEY=your-crypto-service-api-key

# Application
API_V1_STR=/api/v1
PROJECT_NAME=CryptVault
VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

